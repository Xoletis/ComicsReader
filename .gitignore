node_modules
dist
.DS_Store
*.local
*.tsbuildinfo
src-tauri/target
# gen/android is committed (it's the actual Android Studio project, including
# the manual signing setup in app/build.gradle.kts) — everything else under
# gen/ (e.g. a future gen/apple) stays regeneratable/ignored.
src-tauri/gen/*
!src-tauri/gen/android
src-tauri/updater.key
src-tauri/keystore.properties

# Android signing key material must never be committed — generate locally
# (see Documents/cbreader-signing-key on this machine) and set the
# ANDROID_KEY_* GitHub secrets instead (see .github/workflows/release.yml).
*.jks
*.b64
*.base64.txt