{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions (desktop only — updater/process aren't registered on mobile, see capabilities/mobile.json)",
  "windows": [
    "main"
  ],
  "platforms": ["linux", "windows", "macOS"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "fs:allow-app-meta-recursive"
  ]
}
