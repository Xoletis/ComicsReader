<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the system package installer accept the APK we hand it via
         Opener.showViewFileAppChooser() (see src/lib/updaterAndroid.ts) —
         a "normal" permission, granted at install time with no runtime
         prompt. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.cbreader"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:largeHeap="true">
        <!-- openArchive() (src/lib/archive.ts) reads a whole CBZ/CBR into a
             single in-memory buffer regardless of how the file was opened
             (Bibliothèque or "Choisir un fichier") — for large comics
             (200MB+) this can exceed Android's default per-app heap ceiling,
             which is far lower than desktop. largeHeap roughly doubles it,
             a standard low-risk mitigation for apps with legitimately large
             single allocations (this is not a full fix for arbitrarily
             large files, see the true streaming rework needed for that). -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
