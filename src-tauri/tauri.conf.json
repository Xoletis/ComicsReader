{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CBReader",
  "version": "1.2.0",
  "identifier": "com.cbreader.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CBReader",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1OTYzMTcwMUJFOTY4QTMKUldTamFPa2JjREdXZGRzWERkUlZRZTJSUEZObTVQQWJscklWZTlEUk14bndxRWE5T0l1RVN1K0oK",
      "endpoints": [
        "https://github.com/Xoletis/ComicsReader/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["cbz"],
        "name": "Comic Book Zip",
        "description": "Bande dessinée (archive CBZ)",
        "role": "Viewer",
        "mimeType": "application/vnd.comicbook+zip"
      },
      {
        "ext": ["cbr"],
        "name": "Comic Book RAR",
        "description": "Bande dessinée (archive CBR)",
        "role": "Viewer",
        "mimeType": "application/vnd.comicbook-rar"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
